# Calendar-Service required env. Copy zu deploy/compose/.env und Werte setzen.
#
# Google OAuth Client (Web Application Type) — Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI muss matchen mit Dashboard-OAuth-Callback.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# KEIN globales BOT_API_TOKEN mehr. Der calendar-service launcht Bots pro User mit
# einem Token, das beim Calendar-Connect gemintet und in
# User.data.google_calendar.bot_token abgelegt wird (multi-tenant).

# Optional Tuning
CALENDAR_SYNC_INTERVAL=300
CALENDAR_LEAD_TIME=2
LOG_LEVEL=INFO
